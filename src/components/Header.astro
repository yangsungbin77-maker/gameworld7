---
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

// 게임별 메뉴. 도구는 고정, 글은 주소(slug) 앞부분으로 자동으로 모은다 → 새 글을 쓰면 메뉴에 저절로 붙는다.
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const short = (t: string, prefix: RegExp) => t.split(' — ')[0].replace(prefix, '').trim();
const MENUS = [
	{
		key: 'd4',
		label: '디아블로4',
		match: ['/d4-', '/diablo'],
		items: [
			{ href: '/d4-build-planner/', label: '빌드 플래너', icon: '😈' },
			{ href: '/d4-boss-drops/', label: '보스 드랍 테이블', icon: '🗝️' },
			{ href: '/d4-runewords/', label: '룬워드 제작서', icon: '🔮' },
			...posts.filter((p) => /^(diablo|d4-)/.test(p.id)).map((p) => ({ href: `/${p.id}/`, label: short(p.data.title, /^디아블로\s?4\s*/), icon: '📄' })),
		],
	},
	{
		key: 'le',
		label: '라스트에폭',
		match: ['/last-epoch'],
		items: [
			{ href: '/last-epoch-build-affixes/', label: '빌드별 중요 옵션', icon: '⏳' },
			{ href: '/last-epoch-blessings/', label: '축복 정리·빌드별 추천', icon: '🙏' },
			{ href: '/last-epoch-monolith/', label: '모노리스 공략·진행 체크표', icon: '🌀' },
			...posts.filter((p) => /^last-epoch/.test(p.id)).map((p) => ({ href: `/${p.id}/`, label: short(p.data.title, /^라스트\s?에폭\s*/), icon: '📄' })),
		],
	},
].filter((m) => m.items.length);
const path = Astro.url.pathname;
const inMenu = (m: (typeof MENUS)[number]) => m.match.some((x) => path.startsWith(x));
---

<script is:inline>if (self !== top) document.documentElement.classList.add('embedded');</script>
<header>
	<nav>
		<a href="/" class="brand">
			<span class="brand-name">{SITE_TITLE}</span>
			<span class="brand-sub">공략 · 도구 · 무료 웹게임</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">홈</HeaderLink>
			<HeaderLink href="/blog">전체 글</HeaderLink>
			{MENUS.map((m) => (
				<details class:list={['dd', { active: inMenu(m) }]} data-dd>
					<summary>{m.label}<span class="caret" aria-hidden="true">▾</span></summary>
					<div class="dd-panel">
						{m.items.map((it) => (
							<a href={it.href} class:list={{ cur: path === it.href || path === it.href.slice(0, -1) }}><span aria-hidden="true">{it.icon}</span>{it.label}</a>
						))}
					</div>
				</details>
			))}
			<HeaderLink href="/games">게임</HeaderLink>
			<HeaderLink href="/about">소개</HeaderLink>
		</div>

		<details class="mnav" data-dd>
			<summary aria-label="메뉴 열기">메뉴 <span aria-hidden="true">☰</span></summary>
			<div class="mnav-panel">
				<a href="/">홈</a>
				<a href="/blog">전체 글</a>
				{MENUS.map((m) => (
					<div class="mnav-group">
						<p>{m.label}</p>
						{m.items.map((it) => <a href={it.href} class:list={{ cur: path === it.href }}><span aria-hidden="true">{it.icon}</span>{it.label}</a>)}
					</div>
				))}
				<a href="/games">게임</a>
				<a href="/about">소개</a>
			</div>
		</details>
	</nav>
</header>

<script>
	// 드롭다운: 하나를 열면 나머지는 닫고, 바깥을 누르거나 Esc를 누르면 닫는다
	const dds = [...document.querySelectorAll<HTMLDetailsElement>('header [data-dd]')];
	dds.forEach((d) => d.addEventListener('toggle', () => { if (d.open) dds.forEach((o) => o !== d && (o.open = false)); }));
	document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('header [data-dd]')) dds.forEach((d) => (d.open = false)); });
	document.addEventListener('keydown', (e) => { if (e.key === 'Escape') dds.forEach((d) => (d.open = false)); });
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--bg);
		border-bottom: 1px solid var(--border);
	}
	nav {
		width: var(--maxw);
		max-width: calc(100% - 24px);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		height: 52px;
	}
	.brand {
		display: flex;
		align-items: baseline;
		gap: 10px;
		text-decoration: none;
		min-width: 0;
	}
	.brand-name {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.1rem;
		letter-spacing: -0.02em;
		color: var(--accent);
		white-space: nowrap;
	}
	.brand-sub {
		color: var(--text-dim);
		font-size: 0.8rem;
		white-space: nowrap;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 2px;
	}
	.internal-links :global(a),
	.dd summary {
		padding: 0.35em 0.85em;
		color: var(--text-muted);
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		font-weight: 600;
		font-size: 0.86rem;
		text-decoration: none;
		transition: color 0.15s ease, background 0.15s ease;
	}
	.internal-links :global(a:hover),
	.dd summary:hover {
		color: #f1f2f4;
		background: var(--bg-elev);
	}
	.internal-links :global(a.active),
	.dd.active summary {
		color: #f1f2f4;
		background: var(--bg-elev-2);
		border-color: var(--border-strong);
		font-weight: 700;
		text-decoration: none;
	}

	/* 드롭다운 */
	.dd { position: relative; }
	.dd summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.3em; white-space: nowrap; }
	.dd summary::-webkit-details-marker { display: none; }
	.caret { font-size: 0.7em; transition: transform 0.15s ease; }
	.dd[open] .caret { transform: rotate(180deg); }
	.dd-panel {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		min-width: 250px;
		max-height: calc(100vh - 80px);
		overflow-y: auto;
		background: var(--bg-elev);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		padding: 5px;
		box-shadow: 0 14px 40px rgba(0, 0, 0, 0.6);
		display: grid;
	}
	.internal-links .dd-panel :global(a) {
		display: flex;
		gap: 0.6em;
		align-items: center;
		border-radius: 5px;
		padding: 0.5em 0.7em;
		font-size: 0.86rem;
		font-weight: 500;
		color: var(--text);
		white-space: nowrap;
	}
	.internal-links .dd-panel :global(a.cur) { color: var(--accent); }

	/* 휴대폰: 메뉴 버튼 하나로 */
	.mnav { display: none; position: relative; }
	.mnav summary {
		list-style: none;
		cursor: pointer;
		padding: 0.3em 0.8em;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border-strong);
		background: var(--bg-elev-2);
		color: #f1f2f4;
		font-weight: 700;
		font-size: 0.86rem;
	}
	.mnav summary::-webkit-details-marker { display: none; }
	.mnav[open] summary { border-color: var(--accent); color: var(--accent); }
	.mnav-panel {
		position: absolute;
		right: 0;
		top: calc(100% + 10px);
		width: min(300px, calc(100vw - 24px));
		max-height: calc(100vh - 80px);
		overflow-y: auto;
		background: var(--bg-elev);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		padding: 6px;
		box-shadow: 0 14px 40px rgba(0, 0, 0, 0.6);
		display: grid;
	}
	.mnav-panel a {
		display: flex;
		gap: 0.6em;
		padding: 0.7em 0.8em;
		border-radius: 5px;
		color: var(--text);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
	}
	.mnav-panel a:hover, .mnav-panel a.cur { background: var(--bg-elev-2); color: var(--accent); }
	.mnav-group { border-top: 1px solid var(--border); margin-top: 4px; padding-top: 4px; }
	.mnav-group p { margin: 6px 0.8em 2px; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; color: var(--text-dim); }
	.mnav-group a { font-weight: 500; }

	@media (max-width: 900px) {
		.internal-links { display: none; }
		.mnav { display: block; }
	}
	@media (max-width: 1080px) {
		.brand-sub { display: none; }
	}
</style>
