---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import RelatedPosts from '../components/RelatedPosts.astro';

type Heading = { depth: number; slug: string; text: string };
type Props = CollectionEntry<'blog'>['data'] & {
	faq?: { q: string; a: string }[];
	headings?: Heading[];
};

const { title, description, pubDate, updatedDate, heroImage, faq, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
// 현재 글 슬러그(관련 글에서 자기 자신 제외용)
const currentSlug = Astro.url.pathname.replace(/^\/|\/$/g, '');
---

<html lang="ko">
	<head>
		<BaseHead
				title={title}
				description={description}
				image={heroImage}
				type="article"
				publishedTime={pubDate}
				modifiedTime={updatedDate}
				faq={faq}
			/>
		<style>
			.article {
				width: 820px;
				max-width: 100%;
				margin: 0 auto;
				background: var(--bg-elev);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1.6rem 2rem 2rem;
			}
			.toc {
				background: var(--bg-elev-2);
				border: 1px solid var(--border);
				border-left: 4px solid var(--c-blue);
				border-radius: var(--radius-sm);
				padding: 0.9em 1.2em;
				margin: 0 0 2.2rem;
			}
			.toc-title { display: block; font-weight: 700; color: #f1f2f4; margin-bottom: 0.4em; font-size: 0.9rem; }
			.toc ol { margin: 0; padding-left: 1.3em; font-size: 0.95rem; }
			.toc li { margin: 0.25em 0; }
			.toc li::marker { font-family: var(--font-mono); color: var(--text-dim); font-size: 0.85em; }
			.toc a { color: var(--text-muted); text-decoration: none; }
			.toc a:hover { color: var(--accent); text-decoration: underline; }
			.back {
				display: inline-block;
				margin-bottom: 1.2rem;
				color: var(--text-muted);
				font-family: var(--font-mono);
				font-size: 0.78rem;
			}
			.back:hover { color: var(--accent); }
			.hero-image img {
				display: block;
				width: 100%;
				margin: 0 0 1.6rem;
				border-radius: var(--radius-sm);
				border: 1px solid var(--border);
			}
			.post-title {
				margin-bottom: 1.8rem;
				padding-bottom: 1.2rem;
				border-bottom: 1px solid var(--border);
			}
			.post-title h1 {
				font-size: clamp(1.7rem, 4.2vw, 2.4rem);
				line-height: 1.3;
				margin: 0.6rem 0;
			}
			.date {
				color: var(--text-dim);
				font-family: var(--font-mono);
				font-size: 0.8rem;
			}
			.prose {
				color: var(--text);
				font-size: 19px;
				line-height: 1.8;
			}
			.prose :global(h2) {
				margin-top: 2.4rem;
				padding-left: 12px;
				border-left: 4px solid var(--c-amber);
			}
			.prose :global(h3) { margin-top: 1.8rem; }
			.prose :global(a) { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(245, 184, 61, 0.45); }
			.prose :global(ul),
			.prose :global(ol) { padding-left: 1.3em; }
			.prose :global(li) { margin-bottom: 0.4em; }

			/* 표 — 보기 좋게 */
			.prose :global(table) {
				width: 100%;
				border-collapse: collapse;
				margin: 0 0 1.8em;
				font-size: 0.9em;
				border: 1px solid var(--border-strong);
				border-radius: var(--radius-sm);
				overflow: hidden;
			}
			.prose :global(thead th) {
				background: var(--bg-elev-2);
				color: #f1f2f4;
				font-weight: 700;
				text-align: left;
				border-bottom: 2px solid var(--c-amber);
			}
			.prose :global(th),
			.prose :global(td) {
				padding: 0.65em 0.9em;
				border-bottom: 1px solid var(--border);
				border-right: 1px solid var(--border);
				vertical-align: top;
			}
			.prose :global(tbody tr:nth-child(even)) { background: rgba(255, 255, 255, 0.025); }
			.prose :global(tbody tr:hover) { background: rgba(76, 141, 246, 0.07); }
			.prose :global(tr:last-child td) { border-bottom: none; }
			.prose :global(th:last-child),
			.prose :global(td:last-child) { border-right: none; }

			/* 콜아웃 박스 */
			.prose :global(.cg-box) {
				border: 1px solid var(--border);
				border-left: 4px solid var(--c-amber);
				background: var(--bg-elev-2);
				border-radius: var(--radius-sm);
				padding: 1em 1.3em;
				margin: 0 0 1.7em;
			}
			.prose :global(.cg-box > :first-child) { margin-top: 0; }
			.prose :global(.cg-box > :last-child) { margin-bottom: 0; }
			.prose :global(.cg-box p) { margin: 0.4em 0; }
			.prose :global(.cg-box .cg-title) {
				display: block;
				font-weight: 700;
				color: #f1f2f4;
				margin-bottom: 0.35em;
			}
			.prose :global(.cg-summary) { border-left-color: var(--c-amber); background: rgba(245, 184, 61, 0.07); }
			.prose :global(.cg-tip)     { border-left-color: var(--c-blue); background: rgba(76, 141, 246, 0.09); }
			.prose :global(.cg-warn)    { border-left-color: #f59e42; background: rgba(245, 158, 66, 0.09); }
			.prose :global(.cg-danger)  { border-left-color: #f87171; background: rgba(248, 113, 113, 0.10); }

			@media (max-width: 720px) {
				.article { padding: 1rem 1rem 1.4rem; }
				.prose { font-size: 18px; }
				.prose :global(table) { display: block; overflow-x: auto; white-space: nowrap; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="article">
				<a href="/blog" class="back">← 전체 글로</a>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt={title} />
					</div>
				)}
				<div class="post-title">
					<span class="tag">GAMEWORLD7</span>
					<h1>{title}</h1>
					<div class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="last-updated-on">
									 · 마지막 수정 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
				</div>
				{toc.length >= 3 && (
					<nav class="toc" aria-label="목차">
						<span class="toc-title">목차</span>
						<ol>
							{toc.map((h) => (
								<li><a href={`#${h.slug}`}>{h.text}</a></li>
							))}
						</ol>
					</nav>
				)}
				<div class="prose">
					<slot />
				</div>
				<RelatedPosts currentSlug={currentSlug} />
			</article>
		</main>
		<Footer />
	</body>
</html>
