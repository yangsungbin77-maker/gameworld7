---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import data from '../data/d4-runes.json';

type Rune = { en: string; ko: string | null; kind?: string | null; tier?: string | null; order?: number | null; effect_ko?: string | null; drop_ko?: string | null; upgrade_ko?: string | null };
type Item = { id: string; en: string; ko: string | null; kind_ko?: string | null; runes: { en: string; ko: string | null }[]; bases_ko: string[]; sockets?: number | null; level_req?: number | null; class: string; stats_ko: string[]; seasonal?: boolean; unsure?: string | null };
const runes = data.runes as Rune[];
const items = data.items as Item[];
const how = (data.how_ko || []) as string[];
const rules = (data.rules_ko || []) as string[];
const materials = (data.materials || []) as { en: string; ko: string | null; how_ko?: string }[];
const CLS: Record<string, string> = { all: '공용', barbarian: '야만용사', druid: '드루이드', necromancer: '강령술사', rogue: '도적', sorcerer: '원소술사', spiritborn: '혼령사', paladin: '성기사', warlock: '악마술사' };
const nm = (x: { ko: string | null; en: string }) => x.ko || x.en;
const runeKey = (r: { en: string }) => r.en.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const ALL8 = ['barbarian', 'druid', 'necromancer', 'rogue', 'sorcerer', 'spiritborn', 'paladin', 'warlock'];
const who = (c: string) => {
	if (c === 'all') return '';
	const list = c.split(',');
	if (list.length >= 5) return ` · ${ALL8.filter((x) => !list.includes(x)).map((x) => CLS[x]).join('·')} 제외`;
	return ` · ${list.map((x) => CLS[x] || x).join('·')} 전용`;
};
const bases = [...new Set(items.flatMap((i) => i.bases_ko))].sort((a, b) => a.localeCompare(b, 'ko'));

const title = `디아블로4 룬워드 제작 — 시즌${data.season} 룬 조합·옵션·재료 총정리 | 게임월드7`;
const description = `디아블로4 시즌 ${data.season}에서 룬으로 만드는 아이템 ${items.length}종의 필요한 룬 순서, 바탕 아이템과 홈 개수, 옵션을 한국어로 정리했습니다. 가진 룬을 고르면 지금 만들 수 있는 아이템을 바로 보여 줍니다.`;
const faq = [
	{ q: '룬워드는 어떻게 만드나요?', a: how.length ? how.join(' ') : '위 "만드는 법"을 참고하세요.' },
	{ q: '가진 룬으로 뭘 만들 수 있는지 어떻게 보나요?', a: '"내 룬 가방"에서 가진 룬을 누르면, 그 룬만으로 만들 수 있는 아이템에 "지금 제작 가능" 표시가 붙고 맨 앞으로 올라옵니다. 고른 룬은 이 기기에 저장돼요.' },
	{ q: '정보는 언제 기준인가요?', a: `시즌 ${data.season}(패치 ${data.patch}) 기준이며 ${data.updated}에 정리했습니다. 시즌이 바뀌면 룬과 조합법이 달라질 수 있어 다시 확인해 갱신합니다.` },
];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@700;900&display=swap" rel="stylesheet" />
		<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) })} />
	</head>
	<body class="dp-body">
		<Header />
		<main class="rw">
			<section class="rw-hero">
				<span class="rw-eyebrow">DIABLO IV · 시즌 {data.season} · 룬 제작</span>
				<h1>룬워드 제작서</h1>
				<p class="rw-lead">룬 {runes.length}개로 만드는 아이템 {items.length}종. 가진 룬을 고르면 지금 만들 수 있는 것부터 보여 드려요.</p>
			</section>

			{how.length > 0 && (
				<details class="rw-how">
					<summary><h2>만드는 법 <small>호라드림의 함 · {how.length}단계</small></h2></summary>
					<ol>{how.map((h) => <li>{h}</li>)}</ol>
				</details>
			)}

			<section class="rw-bag" aria-label="내 룬 가방">
				<div class="rw-bag-head"><h2>내 룬 가방</h2><button type="button" id="bagClear" class="rw-link">비우기</button></div>
				<p class="rw-note">가진 룬을 누르세요. 한 번 누르면 1개, 두 번이면 2개, 세 번이면 빠져요. 같은 룬이 두 개 필요한 조합은 개수까지 따져 드려요.</p>
				<div class="rw-runes" id="bag">
					{runes.map((r) => (
						<button type="button" class="rw-rune" data-r={runeKey(r)} aria-pressed="false" title={r.effect_ko || ''}>
							<span class="rw-rune-n">{nm(r)}</span><span class="rw-cnt" aria-hidden="true"></span>
						</button>
					))}
				</div>
			</section>

			<div class="rw-tools" role="search">
				<input id="q" type="search" placeholder="아이템·옵션·룬 이름으로 찾기 (예: 극대화, 이동 속도)" aria-label="아이템, 옵션, 룬 이름으로 찾기" />
				<div class="rw-chips" id="baseChips" role="group" aria-label="바탕 아이템 거르기">
					<button type="button" class="on" data-b="" aria-pressed="true">전체</button>
					{bases.map((b) => <button type="button" data-b={b} aria-pressed="false">{b}</button>)}
				</div>
				<p class="rw-count" id="count" aria-live="polite"></p>
			</div>

			<div class="rw-list" id="list">
				{items.map((it) => (
					<article class={`rw-item${it.unsure ? ' unsure' : ''}`} id={it.id} data-item data-runes={JSON.stringify(it.runes.map(runeKey))} data-bases={JSON.stringify(it.bases_ko)} data-n={[it.ko, it.en, ...it.stats_ko, ...it.runes.map((r) => `${r.ko || ''} ${r.en}`), ...it.bases_ko].join(' ').toLowerCase()}>
						<header>
							<h3>{nm(it)}{it.seasonal && <span class="rw-tag">시즌</span>}{it.unsure && <span class="rw-q" title={it.unsure}>확인 중</span>}</h3>
							<p class="rw-sub">{it.ko ? it.en : ''}{it.kind_ko ? ` · ${it.kind_ko}` : ''}{who(it.class)}</p>
							<span class="rw-ready" hidden>지금 제작 가능</span>
						</header>
						<div class="rw-recipe" aria-label="필요한 룬 순서">
							{it.runes.map((r, i) => (<><span class="rw-chip" data-r={runeKey(r)}>{nm(r)}</span>{i < it.runes.length - 1 && <span class="rw-plus" aria-hidden="true">+</span>}</>))}
						</div>
						<p class="rw-base"><b>바탕</b> {it.bases_ko.join(', ') || '—'}{it.sockets ? ` · 홈 ${it.sockets}개` : ' · 일반(흰색) 아이템'}{it.level_req ? ` · 레벨 ${it.level_req}+` : ''}</p>
						{it.stats_ko.length > 0 && <ul class="rw-stats">{it.stats_ko.map((s) => <li>{s}</li>)}</ul>}
						{it.unsure && <p class="rw-why">{it.unsure}</p>}
					</article>
				))}
			</div>
			<p class="rw-none" id="none" hidden>조건에 맞는 아이템이 없어요.</p>

			<section class="rw-block" id="runes">
				<h2>룬 목록</h2>
				<div class="rw-table-wrap">
					<table>
						<thead><tr><th>룬</th><th>종류</th><th>홈에 박았을 때 효과</th><th>얻는 곳</th><th>합성 (호라드림의 함)</th></tr></thead>
						<tbody>
							{runes.map((r) => (
								<tr><td><b>{nm(r)}</b><small>{r.ko ? r.en : ''}</small></td><td>{r.kind || '—'}<small class="rw-tier">{r.tier}</small></td><td>{r.effect_ko || '—'}</td><td>{r.drop_ko || '—'}</td><td>{r.upgrade_ko || '—'}</td></tr>
							))}
						</tbody>
					</table>
				</div>
			</section>

			{materials.length > 0 && (
				<section class="rw-block">
					<h2>그 밖에 필요한 재료</h2>
					<ul class="rw-mats">{materials.map((m) => <li><b>{nm(m)}</b>{m.ko ? <small>{m.en}</small> : ''}<span>{m.how_ko}</span></li>)}</ul>
				</section>
			)}

			<section class="rw-doc">
				{rules.length > 0 && (<><h2>알아 둘 규칙</h2><ul>{rules.map((r) => <li>{r}</li>)}</ul></>)}
				<p>만든 아이템은 <a href="/d4-build-planner/">디아블로4 빌드 플래너</a> 장비 칸에 넣어 빌드를 완성하고, 고유 아이템 파밍은 <a href="/d4-boss-drops/">보스 드랍 테이블</a>에서 확인하세요.</p>
				<h2>자주 묻는 질문</h2>
				{faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
				<p class="rw-legal">게임월드7이 만든 팬 자료이며 Blizzard Entertainment와 관련이 없습니다. 아이템·룬 이름과 옵션은 게임의 한국어 표기를 따랐습니다. 시즌 {data.season} · {data.updated} 기준.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	.dp-body {
		--d-bg: #0d0b0a; --d-panel: #17130f; --d-panel-2: #1f1913; --d-line: #3a2f22;
		--d-gold: #c9a35b; --d-gold-hi: #e6c47f; --d-blood: #d9493a; --d-text: #ece3d3; --d-muted: #a89c88; --d-rune: #7fd1c7;
		background: radial-gradient(1200px 500px at 50% -120px, #2a1a12 0%, transparent 70%), var(--d-bg);
		color: var(--d-text);
	}
	.rw { width: var(--maxw); max-width: calc(100% - 2rem); margin: 0 auto; padding: 1.5rem 0 3rem; }
	.rw h1, .rw h2, .rw h3 { font-family: 'Noto Serif KR', serif; }
	.rw-hero { text-align: center; padding: 1.5rem 0 1rem; }
	.rw-eyebrow { font-size: 0.75rem; letter-spacing: 0.18em; color: var(--d-gold); }
	.rw-hero h1 { font-size: clamp(2rem, 6vw, 3.2rem); font-weight: 900; margin: 0.4rem 0; color: #f4e6c8; text-shadow: 0 0 24px rgba(127, 209, 199, 0.28); }
	.rw-lead { color: var(--d-muted); max-width: 36em; margin: 0 auto; line-height: 1.7; }
	.rw-note { color: var(--d-muted); font-size: 0.84rem; margin: 2px 0 10px; }

	.rw-how, .rw-bag { background: var(--d-panel); border: 1px solid var(--d-line); border-radius: 16px; padding: 16px 18px; margin-top: 16px; }
	.rw-how h2, .rw-bag h2, .rw-block h2, .rw-doc h2 { font-size: 1.25rem; color: #f4e6c8; margin: 0 0 8px; }
	.rw-how summary { cursor: pointer; list-style: none; }
	.rw-how summary::-webkit-details-marker { display: none; }
	.rw-how summary h2 { margin: 0; display: flex; align-items: baseline; gap: 8px; }
	.rw-how summary h2::after { content: '펼치기 ▾'; margin-left: auto; font-family: Pretendard, system-ui, sans-serif; font-size: 0.78rem; color: var(--d-muted); font-weight: 400; }
	.rw-how[open] summary h2::after { content: '접기 ▴'; }
	.rw-how summary small { font-family: Pretendard, system-ui, sans-serif; font-size: 0.8rem; font-weight: 400; color: var(--d-muted); }
	.rw-how ol { margin: 10px 0 0; padding-left: 1.3em; line-height: 1.75; color: var(--d-text); }
	.rw-bag-head { display: flex; justify-content: space-between; align-items: baseline; }
	.rw-link { background: none; border: 0; color: var(--d-muted); font: inherit; font-size: 0.82rem; cursor: pointer; text-decoration: underline; }
	.rw-runes { display: flex; flex-wrap: wrap; gap: 6px; }
	.rw-rune { font: inherit; font-size: 0.86rem; padding: 7px 11px; border-radius: 10px; border: 1px solid var(--d-line); background: var(--d-panel-2); color: var(--d-muted); cursor: pointer; display: inline-flex; gap: 6px; align-items: center; }
	.rw-rune[aria-pressed='true'] { border-color: var(--d-rune); color: #0b1a18; background: var(--d-rune); font-weight: 800; }
	.rw-cnt:empty { display: none; }
	.rw-cnt { font-size: 0.7rem; background: #0b1a18; color: var(--d-rune); border-radius: 999px; padding: 0 6px; }
	.rw-rune:focus-visible, .rw-chips button:focus-visible, .rw-tools input:focus-visible { outline: 2px solid var(--d-gold-hi); outline-offset: 2px; }

	.rw-tools { position: sticky; top: 64px; z-index: 20; background: rgba(13, 11, 10, 0.92); backdrop-filter: blur(8px); padding: 12px 0 8px; margin-top: 16px; border-bottom: 1px solid var(--d-line); }
	.rw-tools input { width: 100%; background: var(--d-panel); border: 1px solid var(--d-line); color: var(--d-text); border-radius: 12px; padding: 12px 14px; font: inherit; font-size: 1rem; }
	.rw-chips { display: flex; gap: 6px; margin-top: 8px; overflow-x: auto; padding-bottom: 2px; }
	.rw-chips button { flex: none; font: inherit; font-size: 0.84rem; padding: 7px 12px; border-radius: 999px; border: 1px solid var(--d-line); background: var(--d-panel); color: var(--d-muted); cursor: pointer; }
	.rw-chips button.on { background: var(--d-gold); color: #1a1208; border-color: var(--d-gold); font-weight: 800; }
	.rw-count { font-size: 0.8rem; color: var(--d-muted); margin: 6px 0 0; min-height: 1.2em; }

	.rw-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 14px; margin-top: 14px; }
	.rw-item { background: var(--d-panel); border: 1px solid var(--d-line); border-radius: 16px; padding: 16px; position: relative; }
	.rw-item[hidden] { display: none; }
	.rw-item.ready { border-color: var(--d-rune); box-shadow: 0 0 0 1px var(--d-rune) inset, 0 8px 24px rgba(127, 209, 199, 0.12); }
	.rw-item.unsure { border-style: dashed; }
	.rw-item h3 { margin: 0; font-size: 1.3rem; color: #f0b56e; }
	.rw-sub { margin: 3px 0 0; font-size: 0.78rem; color: var(--d-muted); }
	.rw-tag { font-family: Pretendard, system-ui, sans-serif; font-size: 0.66rem; vertical-align: middle; margin-left: 6px; padding: 2px 7px; border-radius: 999px; background: var(--d-blood); color: #fff; }
	.rw-q { font-family: Pretendard, system-ui, sans-serif; font-size: 0.66rem; vertical-align: middle; margin-left: 6px; padding: 2px 7px; border-radius: 999px; background: #4a3a1a; color: var(--d-gold-hi); }
	.rw-ready { position: absolute; top: 14px; right: 14px; font-size: 0.7rem; font-weight: 800; color: #0b1a18; background: var(--d-rune); padding: 3px 8px; border-radius: 999px; }
	.rw-ready[hidden] { display: none; }
	.rw-recipe { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; margin: 12px 0 8px; }
	.rw-chip { font-size: 0.86rem; font-weight: 700; padding: 5px 10px; border-radius: 8px; border: 1px solid #2c4a46; color: var(--d-rune); background: #0f1b19; }
	.rw-chip.have { background: var(--d-rune); color: #0b1a18; border-color: var(--d-rune); }
	.rw-plus { color: var(--d-muted); font-size: 0.8rem; }
	.rw-base { font-size: 0.82rem; color: var(--d-muted); margin: 0 0 8px; }
	.rw-base b, .rw-mats b { color: var(--d-gold); margin-right: 4px; }
	.rw-stats { list-style: none; padding: 0; margin: 0; display: grid; gap: 3px; }
	.rw-stats li { font-size: 0.88rem; color: #b9c7f0; padding-left: 12px; position: relative; line-height: 1.5; }
	.rw-stats li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 5px; height: 5px; transform: rotate(45deg); background: #6f80b8; }
	.rw-why { font-size: 0.76rem; color: #b89a6a; margin: 8px 0 0; }
	.rw-none { color: var(--d-muted); text-align: center; padding: 20px; }

	.rw-block { margin-top: 32px; }
	.rw-table-wrap { overflow-x: auto; background: var(--d-panel); border: 1px solid var(--d-line); border-radius: 14px; }
	.rw-block table { width: 100%; border-collapse: collapse; font-size: 0.86rem; min-width: 640px; }
	.rw-block th { text-align: left; color: var(--d-gold); font-size: 0.76rem; padding: 9px 10px; border-bottom: 1px solid var(--d-line); }
	.rw-block td { padding: 9px 10px; border-bottom: 1px solid var(--d-line); vertical-align: top; color: var(--d-muted); line-height: 1.5; }
	.rw-block td b { color: var(--d-rune); display: block; }
	.rw-block td small { font-size: 0.7rem; }
	.rw-block td small.rw-tier { display: block; color: var(--d-gold); margin-top: 2px; }
	.rw-mats { list-style: none; padding: 0; display: grid; gap: 8px; }
	.rw-mats li { background: var(--d-panel); border: 1px solid var(--d-line); border-radius: 12px; padding: 10px 12px; font-size: 0.88rem; color: var(--d-muted); }
	.rw-mats small { margin-right: 8px; font-size: 0.72rem; }
	.rw-mats span { display: block; margin-top: 3px; }

	.rw-doc { margin-top: 36px; border-top: 1px solid var(--d-line); padding-top: 20px; line-height: 1.75; }
	.rw-doc a { color: var(--d-gold-hi); }
	.rw-doc details { border-bottom: 1px solid var(--d-line); padding: 8px 0; }
	.rw-doc summary { cursor: pointer; font-weight: 700; }
	.rw-doc p, .rw-doc li { color: var(--d-muted); }
	.rw-legal { font-size: 0.78rem; margin-top: 18px; }
	@media (max-width: 420px) { .rw-list { grid-template-columns: 1fr; } .rw-tools { top: 56px; } }
</style>

<script>
	const q = document.getElementById('q') as HTMLInputElement;
	const LS = 'gw7:d4:runebag';
	let bag: Record<string, number> = {};
	try { bag = JSON.parse(localStorage.getItem(LS) || '{}'); } catch {}
	let base = '';
	const cards = [...document.querySelectorAll<HTMLElement>('[data-item]')];
	const order = new Map(cards.map((c, i) => [c, i]));

	function canMake(need: string[]) {
		const want: Record<string, number> = {};
		need.forEach((r) => (want[r] = (want[r] || 0) + 1));
		return Object.entries(want).every(([r, n]) => (bag[r] || 0) >= n);
	}
	function render() {
		const t = q.value.trim().toLowerCase();
		const anyBag = Object.values(bag).some((n) => n > 0);
		document.querySelectorAll<HTMLElement>('.rw-rune').forEach((b) => {
			const n = bag[b.dataset.r!] || 0;
			b.setAttribute('aria-pressed', String(n > 0));
			(b.querySelector('.rw-cnt') as HTMLElement).textContent = n > 1 ? '×' + n : '';
		});
		let shown = 0, ready = 0;
		for (const c of cards) {
			const need: string[] = JSON.parse(c.dataset.runes || '[]');
			const bases: string[] = JSON.parse(c.dataset.bases || '[]');
			const ok = (!t || c.dataset.n!.includes(t)) && (!base || bases.includes(base));
			c.hidden = !ok; if (ok) shown++;
			const r = anyBag && need.length > 0 && canMake(need);
			c.classList.toggle('ready', r); (c.querySelector('.rw-ready') as HTMLElement).hidden = !r; if (r && ok) ready++;
			c.querySelectorAll<HTMLElement>('.rw-chip').forEach((ch) => ch.classList.toggle('have', (bag[ch.dataset.r!] || 0) > 0));
		}
		// 제작 가능한 것을 앞으로
		const list = document.getElementById('list')!;
		[...cards].sort((a, b) => (Number(b.classList.contains('ready')) - Number(a.classList.contains('ready'))) || order.get(a)! - order.get(b)!).forEach((c) => list.appendChild(c));
		document.getElementById('none')!.hidden = shown > 0;
		document.getElementById('count')!.textContent = (t || base ? `아이템 ${shown}개` : '') + (anyBag ? `${t || base ? ' · ' : ''}지금 만들 수 있는 것 ${ready}개` : '');
		try { localStorage.setItem(LS, JSON.stringify(bag)); } catch {}
	}
	// 룬 버튼: 누를 때마다 0 → 1 → 2 → 0 (같은 룬 두 개 필요한 조합 대비)
	document.getElementById('bag')!.addEventListener('click', (e) => {
		const b = (e.target as HTMLElement).closest('[data-r]') as HTMLElement | null; if (!b) return;
		const k = b.dataset.r!; bag[k] = ((bag[k] || 0) + 1) % 3; if (!bag[k]) delete bag[k];
		render();
	});
	document.getElementById('bagClear')!.addEventListener('click', () => { bag = {}; render(); });
	q.addEventListener('input', render);
	document.getElementById('baseChips')!.addEventListener('click', (e) => {
		const b = (e.target as HTMLElement).closest('button'); if (!b) return;
		base = b.dataset.b || '';
		document.querySelectorAll('#baseChips button').forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
		render();
	});
	const p = new URLSearchParams(location.search);
	if (p.get('q')) q.value = p.get('q')!;
	render();
</script>
