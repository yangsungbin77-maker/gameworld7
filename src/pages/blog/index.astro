---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`전체 글 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="panel">
			<header class="panel-head page-head">
				<h1 class="panel-title" style="--bar:var(--c-pink)"><span>전체 글</span></h1>
				<p>게임 뉴스, 공략, 리뷰를 한곳에서.</p>
				<span class="panel-note">{posts.length}편</span>
			</header>
			<ul class="grid">
				{
					posts.map((post) => (
						<li>
							<a href={`/${post.id}/`} class="card">
								{post.data.heroImage && (
									<div class="card-image">
										<Image src={post.data.heroImage} width={600} height={300} alt={post.data.title} />
									</div>
								)}
								<div class="card-body">
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<span class="meta">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</div>
							</a>
						</li>
					))
				}
			</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head { justify-content: flex-start; flex-wrap: wrap; }
	.page-head p { color: var(--text-muted); font-size: 0.86rem; margin: 0; flex: 1; }

	.grid {
		list-style: none;
		padding: 10px;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
		gap: 10px;
	}
	.card {
		display: flex;
		flex-direction: column;
		height: 100%;
		background: var(--bg-elev-2);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		overflow: hidden;
		transition: border-color 0.15s ease;
	}
	.card:hover { border-color: var(--c-blue); }
	.card-image img {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		border-radius: 0;
		border-bottom: 1px solid var(--border);
	}
	.card-body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 13px 14px 14px;
	}
	.card h3 { margin: 0 0 7px; font-size: 1.02rem; line-height: 1.45; }
	.card p {
		color: var(--text-muted);
		font-size: 0.88rem;
		line-height: 1.65;
		margin: 0 0 12px;
		flex: 1;
	}
	.meta { font-family: var(--font-mono); color: var(--text-dim); font-size: 0.74rem; }
	@media (max-width: 720px) {
		.grid { grid-template-columns: minmax(0, 1fr); }
		.card h3 { font-size: 1.1rem; }
		.card p { font-size: 0.93rem; }
	}
</style>
