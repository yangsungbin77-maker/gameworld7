---
import Guide_arrow_escape from '../components/guides/arrow-escape.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const title = '애로우 이스케이프 — 화살표 탈출 퍼즐 무료 게임 | 게임월드7';
const description =
	'막힌 화살표를 누르면 하트가 깎여요! 길이 뚫린 화살표만 골라 판을 비우는 두뇌 퍼즐. 레벨이 오를수록 판이 커지는 무한 스테이지 · 무료 · 설치 없음.';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<div id="arrowgame">
				<section class="game-hero">
					<span class="tag">PLAY · 퍼즐</span>
					<h1>➡️ <span class="neon">애로우 이스케이프</span></h1>
					<p class="lead">앞이 뚫린 화살표만 눌러서 판을 전부 비우세요. 막힌 걸 누르면 <strong>하트 ♥</strong>가 줄어요.</p>
				</section>

				<div class="panel">
					<div class="hud">
						<div class="hearts" id="hearts" aria-label="남은 하트"></div>
						<div class="hud-mid">
							<strong id="level">레벨 1</strong>
							<small id="left">남은 화살표 0개</small>
						</div>
						<button class="pill" id="hintBtn" type="button">💡 힌트 3</button>
					</div>

					<div class="stage" id="stage">
						<canvas id="board" aria-label="애로우 이스케이프 보드"></canvas>
						<div class="overlay hidden" id="overlay">
							<h2 id="ov-title">레벨 1 클리어!</h2>
							<div class="stars" id="ov-stars"></div>
							<p id="ov-sub"></p>
							<button class="pill big" id="ov-btn" type="button">다음 레벨</button>
						</div>
					</div>

					<div class="foot">
						<button class="pill" id="restartBtn" type="button">↻ 다시 시작</button>
						<button class="pill" id="soundBtn" type="button" aria-label="효과음 켜기/끄기">🔊</button>
					</div>
				</div>

				<section class="how">
					<h2>하는 법</h2>
					<ol>
						<li>화살표를 누르면 그 방향으로 날아가요.</li>
						<li>가는 길에 다른 화살표가 있으면 부딪히고 <b>하트가 1개</b> 줄어요. 하트 3개를 다 잃으면 다시 시작이에요.</li>
						<li>판의 화살표를 모두 내보내면 클리어! 남은 하트만큼 별을 받아요.</li>
						<li>막막하면 💡 힌트로 지금 나갈 수 있는 화살표를 확인하세요(판마다 3번).</li>
					</ol>
					<p>
						모든 판은 반드시 풀리도록 만들어져 있어요. 화살표를 거꾸로 하나씩 놓으면서 판을 짜기 때문에, 길이 뚫린 것부터
						차례로 빼면 언제나 끝까지 갈 수 있어요. 진행 단계는 브라우저에 저장돼서 다음에 와도 이어서 할 수 있어요.
					</p>
				</section>
			</div>
			<Guide_arrow_escape />
		</main>
		<Footer />

		<script is:inline>
			(() => {
				const canvas = document.getElementById('board');
				const ctx = canvas.getContext('2d');
				const stage = document.getElementById('stage');
				const heartsEl = document.getElementById('hearts');
				const levelEl = document.getElementById('level');
				const leftEl = document.getElementById('left');
				const hintBtn = document.getElementById('hintBtn');
				const overlay = document.getElementById('overlay');
				const ovTitle = document.getElementById('ov-title');
				const ovStars = document.getElementById('ov-stars');
				const ovSub = document.getElementById('ov-sub');
				const ovBtn = document.getElementById('ov-btn');
				const soundBtn = document.getElementById('soundBtn');

				const LEVEL_KEY = 'gw7_arrow_level';
				const SOUND_KEY = 'gw7_arrow_sound';
				const MAX_HEARTS = 3;
				const MAX_HINTS = 3;
				const PAD = 12;
				const DIRS = [[0, -1], [0, 1], [-1, 0], [1, 0]];
				const COLORS = { '0,-1': '#4f8ef7', '0,1': '#f39c4a', '-1,0': '#2fbf71', '1,0': '#b86be0' };

				const store = {
					get(k) { try { return localStorage.getItem(k); } catch { return null; } },
					set(k, v) { try { localStorage.setItem(k, v); } catch {} },
				};

				let level = Math.max(1, Number(store.get(LEVEL_KEY)) || 1);
				let cols = 4, rows = 6, cell = 60, dpr = 1;
				let grid = new Map(); // "x,y" -> piece
				let pieces = []; // every piece still drawn (including flying ones)
				let hearts = MAX_HEARTS, hints = MAX_HINTS, state = 'play';
				let combo = 0, lastClear = 0;

				// ── 판 만들기: 길이 뚫린 칸에만 화살표를 놓으므로 언제나 풀린다 ──
				function rng(seed) {
					return () => {
						seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
						let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
						t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
						return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
					};
				}
				function shuffle(a, r) {
					for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(r() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
					return a;
				}
				function pathClear(map, x, y, d, w, h) {
					let px = x + d[0], py = y + d[1];
					while (px >= 0 && px < w && py >= 0 && py < h) {
						if (map.has(px + ',' + py)) return false;
						px += d[0]; py += d[1];
					}
					return true;
				}
				function generate(lvl, w, h, density) {
					const r = rng(7919 * lvl + 104729);
					const cells = [];
					for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) cells.push([x, y]);
					const target = Math.floor(w * h * density);
					const placed = new Map();
					for (let pass = 0; pass < 4; pass++) {
						for (const [x, y] of shuffle(cells, r)) {
							if (placed.size >= target) break;
							if (placed.has(x + ',' + y)) continue;
							for (const d of shuffle(DIRS.slice(), r)) {
								if (pathClear(placed, x, y, d, w, h)) { placed.set(x + ',' + y, d); break; }
							}
						}
					}
					return placed;
				}

				// ── 레벨 시작 ──
				function startLevel() {
					cols = Math.min(9, Math.max(4, 4 + Math.floor(level / 3)));
					rows = Math.min(13, Math.max(6, cols + 2 + Math.floor(level / 5)));
					const density = Math.min(0.6 + level * 0.012, 0.9);
					const layout = generate(level, cols, rows, density);
					grid = new Map(); pieces = [];
					hearts = MAX_HEARTS; hints = MAX_HINTS; state = 'play'; combo = 0;
					const now = performance.now();
					let i = 0;
					for (const [key, d] of layout) {
						const [x, y] = key.split(',').map(Number);
						const p = { x, y, d, color: COLORS[d.join(',')], spawn: now + i * 12, ox: 0, oy: 0, flash: 0 };
						grid.set(key, p); pieces.push(p); i++;
					}
					overlay.classList.add('hidden');
					resize(); refreshHud();
				}

				function resize() {
					const maxW = stage.clientWidth;
					const maxH = Math.max(320, window.innerHeight * 0.66);
					cell = Math.floor(Math.min((maxW - PAD * 2) / cols, (maxH - PAD * 2) / rows));
					const w = cols * cell + PAD * 2, h = rows * cell + PAD * 2;
					dpr = window.devicePixelRatio || 1;
					canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
					canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
				}

				function refreshHud() {
					levelEl.textContent = '레벨 ' + level;
					leftEl.textContent = '남은 화살표 ' + grid.size + '개';
					heartsEl.innerHTML = '';
					for (let i = 0; i < MAX_HEARTS; i++) {
						const s = document.createElement('span');
						s.textContent = '♥';
						if (i >= hearts) s.className = 'lost';
						heartsEl.appendChild(s);
					}
					hintBtn.textContent = '💡 힌트 ' + hints;
					hintBtn.disabled = hints <= 0;
				}

				// ── 이동 ──
				function firstBlocker(p) {
					let x = p.x + p.d[0], y = p.y + p.d[1];
					while (x >= 0 && x < cols && y >= 0 && y < rows) {
						const b = grid.get(x + ',' + y);
						if (b) return b;
						x += p.d[0]; y += p.d[1];
					}
					return null;
				}

				function tap(p) {
					if (state !== 'play' || p.fly || p.bump) return;
					const b = firstBlocker(p);
					const now = performance.now();
					if (!b) {
						grid.delete(p.x + ',' + p.y);
						p.fly = now; p.glow = 0;
						combo = now - lastClear < 900 ? combo + 1 : 0;
						lastClear = now;
						beep([880, 1320], 0.06, 0.25, 1 + Math.min(combo, 10) * 0.07);
						refreshHud();
						if (grid.size === 0) win();
					} else {
						const gap = Math.abs(b.x - p.x) + Math.abs(b.y - p.y) - 1;
						p.bump = { t0: now, gap };
						b.shake = { t0: now + 50 + 35 * gap, d: p.d };
						hearts--; combo = 0;
						beep([140, 110], 0.09, 0.35, 1);
						if (navigator.vibrate) navigator.vibrate(70);
						heartsEl.classList.remove('shake'); void heartsEl.offsetWidth; heartsEl.classList.add('shake');
						refreshHud();
						if (hearts <= 0) lose();
					}
				}

				function useHint() {
					if (state !== 'play' || hints <= 0) return;
					for (const p of grid.values()) {
						if (!p.bump && !firstBlocker(p)) {
							hints--; p.glow = performance.now(); refreshHud(); return;
						}
					}
				}

				function win() {
					state = 'win';
					const stars = hearts;
					level++; store.set(LEVEL_KEY, String(level));
					setTimeout(() => {
						beep([523, 659, 784, 1047], 0.11, 0.22, 1);
						showOverlay('레벨 ' + (level - 1) + ' 클리어!', stars, '', '다음 레벨');
					}, 550);
				}
				function lose() {
					state = 'lose';
					setTimeout(() => {
						beep([392, 330, 262], 0.16, 0.22, 1);
						showOverlay('하트를 다 썼어요', -1, '누르기 전에 앞길을 먼저 보세요!', '다시 도전');
					}, 400);
				}
				function showOverlay(title, stars, sub, btn) {
					ovTitle.textContent = title;
					ovStars.textContent = stars >= 0 ? '★'.repeat(stars) + '☆'.repeat(MAX_HEARTS - stars) : '';
					ovSub.textContent = sub;
					ovBtn.textContent = btn;
					overlay.classList.remove('hidden');
				}

				// ── 그리기 ──
				const easeIn = (t) => t * t;
				const easeOutBack = (t) => 1 + 2.70158 * Math.pow(t - 1, 3) + 1.70158 * Math.pow(t - 1, 2);
				const clamp01 = (t) => Math.max(0, Math.min(1, t));

				function update(now) {
					const W = canvas.width / dpr, H = canvas.height / dpr;
					const reach = Math.max(W, H) + cell * 2;
					pieces = pieces.filter((p) => {
						p.ox = 0; p.oy = 0; p.flash = 0;
						p.scale = easeOutBack(clamp01((now - p.spawn) / 220));
						if (p.fly) {
							const t = now - p.fly;
							const back = (Math.min(t, 60) / 60) * -0.12 * cell;
							const go = t > 60 ? easeIn(clamp01((t - 60) / 420)) * reach : 0;
							p.ox = p.d[0] * (back + go); p.oy = p.d[1] * (back + go);
							if (t > 480) return false;
						}
						if (p.bump) {
							const t = now - p.bump.t0, d1 = 50 + 35 * p.bump.gap;
							const dist = p.bump.gap * cell + cell * 0.16;
							let k;
							if (t < d1) k = easeIn(t / d1);
							else if (t < d1 + 180) k = 1 - easeOutBack((t - d1) / 180);
							else k = 0;
							p.ox = p.d[0] * dist * k; p.oy = p.d[1] * dist * k;
							p.flash = t < d1 + 180 ? 1 : 1 - clamp01((t - d1 - 180) / 250);
							if (t > d1 + 430) p.bump = null;
						}
						if (p.shake) {
							const t = now - p.shake.t0;
							if (t >= 0 && t < 120) {
								const k = t < 40 ? t / 40 : 1 - (t - 40) / 80;
								p.ox += p.shake.d[0] * 6 * k; p.oy += p.shake.d[1] * 6 * k;
							} else if (t >= 120) p.shake = null;
						}
						return true;
					});
				}

				function draw(now) {
					ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
					const W = canvas.width / dpr, H = canvas.height / dpr;
					ctx.clearRect(0, 0, W, H);
					ctx.fillStyle = '#25274a';
					ctx.beginPath(); ctx.roundRect(0, 0, W, H, 22); ctx.fill();
					ctx.fillStyle = 'rgba(255,255,255,0.08)';
					for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
						ctx.beginPath();
						ctx.arc(PAD + (x + 0.5) * cell, PAD + (y + 0.5) * cell, Math.max(2, cell * 0.04), 0, Math.PI * 2);
						ctx.fill();
					}
					for (const p of pieces) drawPiece(p, now);
				}

				function mix(hex, to, k) {
					const a = parseInt(hex.slice(1), 16), b = parseInt(to.slice(1), 16);
					const ch = (s) => Math.round(((a >> s) & 255) * (1 - k) + ((b >> s) & 255) * k);
					return `rgb(${ch(16)},${ch(8)},${ch(0)})`;
				}

				function drawPiece(p, now) {
					if (p.scale <= 0) return;
					const s = cell * 0.86;
					const cx = PAD + (p.x + 0.5) * cell + p.ox, cy = PAD + (p.y + 0.5) * cell + p.oy;
					const r = s * 0.24;
					ctx.save();
					ctx.translate(cx, cy); ctx.scale(p.scale, p.scale);
					const base = p.flash > 0 ? mix(p.color, '#ff4d4d', p.flash) : p.color;
					ctx.fillStyle = mix(p.color, '#000000', 0.35);
					ctx.beginPath(); ctx.roundRect(-s / 2, -s / 2 + s * 0.07, s, s, r); ctx.fill();
					ctx.fillStyle = base;
					ctx.beginPath(); ctx.roundRect(-s / 2, -s / 2, s, s, r); ctx.fill();
					if (p.glow) {
						const t = (now - p.glow) / 500;
						if (t > 3) p.glow = 0;
						else {
							ctx.strokeStyle = `rgba(255,219,77,${0.5 - 0.5 * Math.cos(t * Math.PI * 2)})`;
							ctx.lineWidth = Math.max(3, s * 0.07);
							ctx.beginPath(); ctx.roundRect(-s / 2 - 6, -s / 2 - 6, s + 12, s + 12, r + 6); ctx.stroke();
						}
					}
					ctx.rotate(Math.atan2(p.d[1], p.d[0]));
					const w = s * 0.5;
					ctx.fillStyle = '#fff';
					ctx.beginPath();
					ctx.moveTo(-w * 0.62, -w * 0.15); ctx.lineTo(w * 0.04, -w * 0.15); ctx.lineTo(w * 0.04, -w * 0.44);
					ctx.lineTo(w * 0.64, 0); ctx.lineTo(w * 0.04, w * 0.44); ctx.lineTo(w * 0.04, w * 0.15);
					ctx.lineTo(-w * 0.62, w * 0.15); ctx.closePath(); ctx.fill();
					ctx.restore();
				}

				function loop(now) {
					update(now); draw(now);
					requestAnimationFrame(loop);
				}

				// ── 효과음 (파일 없이 즉석 합성) ──
				let audio = null;
				let soundOn = store.get(SOUND_KEY) !== '0';
				function beep(freqs, len, vol, pitch) {
					if (!soundOn) return;
					try {
						if (!audio) audio = new (window.AudioContext || window.webkitAudioContext)();
						let t = audio.currentTime;
						for (const f of freqs) {
							const o = audio.createOscillator(), g = audio.createGain();
							o.frequency.value = f * pitch;
							g.gain.setValueAtTime(vol, t);
							g.gain.exponentialRampToValueAtTime(0.001, t + len);
							o.connect(g).connect(audio.destination);
							o.start(t); o.stop(t + len);
							t += len;
						}
					} catch {}
				}
				function refreshSound() { soundBtn.textContent = soundOn ? '🔊' : '🔇'; }

				// ── 입력 ──
				canvas.addEventListener('pointerdown', (e) => {
					const rect = canvas.getBoundingClientRect();
					const x = Math.floor((e.clientX - rect.left - PAD) / cell);
					const y = Math.floor((e.clientY - rect.top - PAD) / cell);
					const p = grid.get(x + ',' + y);
					if (p) tap(p);
				});
				hintBtn.addEventListener('click', useHint);
				document.getElementById('restartBtn').addEventListener('click', startLevel);
				ovBtn.addEventListener('click', startLevel);
				soundBtn.addEventListener('click', () => {
					soundOn = !soundOn; store.set(SOUND_KEY, soundOn ? '1' : '0'); refreshSound();
				});
				window.addEventListener('resize', resize);

				refreshSound();
				startLevel();
				requestAnimationFrame(loop);
			})();
		</script>
	</body>
</html>

<style>
	/* touch-action: manipulation = 연타해도 화면이 확대되지 않게 */
	#arrowgame { max-width: 560px; margin: 0 auto; touch-action: manipulation; }
	.game-hero { padding: 2rem 0 1.2rem; text-align: center; }
	.game-hero h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); margin: 0.5rem 0; }
	.neon { color: var(--accent); text-shadow: 0 0 24px var(--accent-glow); }
	.lead { color: var(--text-muted); font-size: 1.05rem; }

	.panel {
		background: #1b1c33; border: 1px solid var(--border); border-radius: var(--radius);
		padding: 14px 12px 16px; box-shadow: 0 0 40px rgba(184, 107, 224, 0.12);
	}
	.hud { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; margin-bottom: 10px; }
	.hearts { color: #ff5d73; font-size: 1.5rem; letter-spacing: 2px; }
	.hearts :global(.lost) { color: rgba(255, 255, 255, 0.18); }
	.hearts.shake { animation: shake 0.25s; }
	@keyframes shake { 25% { transform: translateX(8px); } 50% { transform: translateX(-8px); } 75% { transform: translateX(6px); } }
	.hud-mid { display: flex; flex-direction: column; align-items: center; }
	.hud-mid strong { color: #fff; font-size: 1.25rem; }
	.hud-mid small { color: rgba(255, 255, 255, 0.55); font-size: 0.8rem; }
	#hintBtn { justify-self: end; }

	.pill {
		background: #3a3d6e; border: 0; border-radius: 14px; color: #fff; font-weight: 700;
		padding: 0.55em 1.1em; cursor: pointer; font-size: 0.95rem;
	}
	.pill:hover:not(:disabled) { background: #4a4e8a; }
	.pill:disabled { opacity: 0.45; cursor: default; }
	.pill.big { font-size: 1.1rem; padding: 0.7em 2em; }

	.stage { position: relative; display: flex; justify-content: center; }
	#board { display: block; touch-action: none; cursor: pointer; }
	.overlay {
		position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
		gap: 0.6rem; background: rgba(13, 13, 31, 0.8); backdrop-filter: blur(3px); border-radius: 22px; text-align: center;
		animation: fadein 0.25s;
	}
	.overlay.hidden { display: none; }
	.overlay h2 { color: #fff; margin: 0; font-size: 1.8rem; }
	.overlay p { color: #ffd34d; margin: 0; }
	.stars { color: #ffd34d; font-size: 2.6rem; letter-spacing: 6px; }
	@keyframes fadein { from { opacity: 0; } }

	.foot { display: flex; justify-content: center; gap: 0.6rem; margin-top: 14px; }

	.how { margin: 2rem 0 1rem; line-height: 1.75; }
	.how h2 { font-size: 1.3rem; }
	.how ol { padding-left: 1.3rem; }
</style>
