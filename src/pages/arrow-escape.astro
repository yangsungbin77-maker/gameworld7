---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const title = '애로우 이스케이프 — 화살표 탈출 퍼즐 무료 게임 | 게임월드7';
const description =
	'막힌 화살표를 누르면 하트가 깎여요! 길이 뚫린 화살표만 골라 판을 비우는 두뇌 퍼즐. 레벨이 오를수록 판이 커지는 무한 스테이지 · 무료 · 설치 없음.';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<div id="arrowgame">
				<section class="game-hero">
					<span class="tag">PLAY · 퍼즐</span>
					<h1>➡️ <span class="neon">애로우 이스케이프</span></h1>
					<p class="lead">앞이 뚫린 화살표만 눌러서 판을 전부 비우세요. 막힌 걸 누르면 <strong>하트 ♥</strong>가 줄어요.</p>
				</section>

				<div class="stage" id="stage">
					<iframe
						id="gameframe"
						src="/play/arrow-escape/index.html"
						title="애로우 이스케이프 게임"
						allow="fullscreen; autoplay"
						loading="eager"></iframe>
				</div>
				<div class="stage-foot">
					<button class="btn" id="fsBtn" type="button">⛶ 전체 화면</button>
					<span class="note">처음 한 번은 게임 파일(약 10MB)을 받느라 몇 초 걸려요.</span>
				</div>

				<section class="how">
					<h2>하는 법</h2>
					<ol>
						<li>화살표를 누르면 그 방향으로 날아가요.</li>
						<li>가는 길에 다른 화살표가 있으면 부딪히고 <b>하트가 1개</b> 줄어요. 하트 3개를 다 잃으면 다시 시작이에요.</li>
						<li>판의 화살표를 모두 내보내면 클리어! 남은 하트만큼 별을 받아요.</li>
						<li>막막하면 오른쪽 위 💡 버튼으로 지금 나갈 수 있는 화살표를 확인하세요(판마다 3번).</li>
					</ol>
					<p>
						모든 판은 반드시 풀리도록 만들어져 있어요. 화살표를 거꾸로 하나씩 놓으면서 판을 짜기 때문에, 길이 뚫린 것부터
						차례로 빼면 언제나 끝까지 갈 수 있어요. 진행 단계는 브라우저에 저장돼서 다음에 와도 이어서 할 수 있어요.
					</p>
				</section>
			</div>
		</main>
		<Footer />

		<script>
			const stage = document.getElementById('stage');
			document.getElementById('fsBtn')?.addEventListener('click', () => {
				if (document.fullscreenElement) document.exitFullscreen();
				else stage?.requestFullscreen?.();
			});
		</script>
	</body>
</html>

<style>
	#arrowgame { max-width: 560px; margin: 0 auto; }
	.game-hero { padding: 2rem 0 1.2rem; text-align: center; }
	.game-hero h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); margin: 0.5rem 0; }
	.neon { color: var(--accent); text-shadow: 0 0 24px var(--accent-glow); }
	.lead { color: var(--text-muted); font-size: 1.05rem; }

	/* 세로형(9:16) 게임 화면. 화면 높이를 넘지 않게 줄어든다. */
	.stage {
		width: min(100%, calc(78vh * 9 / 16)); aspect-ratio: 9 / 16; margin-inline: auto;
		border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;
		background: #1b1c33; box-shadow: 0 0 40px rgba(184, 107, 224, 0.15);
	}
	.stage:fullscreen { width: 100%; height: 100%; aspect-ratio: auto; border: 0; border-radius: 0; }
	#gameframe { display: block; width: 100%; height: 100%; border: 0; }

	.stage-foot { display: flex; align-items: center; justify-content: center; gap: 0.8rem; flex-wrap: wrap; margin: 0.9rem 0 0; }
	.btn {
		background: var(--bg-elev); border: 1px solid var(--border); border-radius: 999px; color: var(--text);
		padding: 0.45em 1.2em; font-weight: 600; cursor: pointer;
	}
	.btn:hover { border-color: var(--accent); }
	.note { color: var(--text-muted); font-size: 0.85rem; }

	.how { margin: 2rem 0 1rem; line-height: 1.75; }
	.how h2 { font-size: 1.3rem; }
	.how ol { padding-left: 1.3rem; }
</style>
