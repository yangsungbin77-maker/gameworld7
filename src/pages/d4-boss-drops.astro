---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import data from '../data/d4-bosses.json';

type Drop = { en: string; ko: string | null; slot_ko?: string; class: string; mythic?: boolean; unsure?: string; equip?: string[] };
type Boss = { id: string; en: string; ko: string | null; location_ko?: string; material?: { en?: string; ko?: string | null; per_summon?: number | null; how_ko?: string } | null; tiers_ko?: string; seasonal?: boolean; group: string; trophy?: { ko: string | null; en: string | null } | null; drops: Drop[] };
const bosses = data.bosses as Boss[];
const mythics = (data.mythics || []) as (Drop & { from_ko?: string })[];
const rules = (data.rules_ko || []) as string[];
const CLASSES: [string, string][] = [['all', '공용'], ['barbarian', '야만용사'], ['druid', '드루이드'], ['necromancer', '강령술사'], ['rogue', '도적'], ['sorcerer', '원소술사'], ['spiritborn', '혼령사'], ['paladin', '성기사'], ['warlock', '악마술사']];
const CLS = Object.fromEntries(CLASSES);
const nm = (x: { ko: string | null; en: string }) => x.ko || x.en;
const totalDrops = bosses.reduce((n, b) => n + b.drops.length, 0);
const GROUPS: [string, string, string][] = [
	['initiate', '입문자 소굴 우두머리', '소굴 열쇠로 비축고를 엽니다. 여기서 상급 소굴 열쇠가 나와요.'],
	['greater', '상급 소굴 우두머리', '상급 소굴 열쇠가 필요해요. 입문자 우두머리 비축고에서 얻습니다.'],
	['top', '최상위 우두머리', '정해진 목록 대신 특별한 규칙으로 보상을 줘요.'],
	['other', '악몽 심화 · 지옥불 군세', '활동 마지막에 만나는 우두머리예요.'],
	['season', `시즌 ${data.season} 전용`, '이번 시즌에만 열리는 콘텐츠예요.'],
];
const mythicNote = (data as { mythic_note_ko?: string }).mythic_note_ko || '';

const title = '디아블로4 보스 드랍 테이블 — 시즌15 보스별 고유·신화 아이템 | 게임월드7';
const description = `디아블로4 시즌 15 보스 ${bosses.length}종이 주는 고유·신화 아이템을 한 표로 정리했습니다. 아이템 이름으로 어느 보스를 잡아야 하는지 바로 찾고, 직업별로 걸러 보고, 소환 재료와 개수까지 확인하세요.`;
const faq = [
	{ q: '원하는 고유 아이템은 어느 보스를 잡아야 나오나요?', a: '위 검색창에 아이템 이름 일부를 치면 그 아이템을 주는 보스만 남습니다. 직업 버튼을 누르면 내 직업 아이템만 표시돼요. 보스마다 지정된 목록 안에서 떨어지기 때문에, 목록에 없는 보스를 잡으면 그 아이템은 나오지 않습니다.' },
	{ q: '신화(Mythic) 고유는 어디서 나오나요?', a: '아래 "신화 고유" 표에 아이템별로 정리했습니다. 신화는 드랍 확률이 낮고 높은 난이도 조건이 붙는 경우가 많아, 표의 규칙 메모를 함께 확인하세요.' },
	{ q: '드랍 정보는 언제 기준인가요?', a: `시즌 ${data.season}(패치 ${data.patch}) 기준이며 ${data.updated} 에 정리했습니다. 시즌이 바뀌면 보스 목록과 드랍 표가 달라질 수 있어 다시 확인해 갱신합니다.` },
];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@700;900&display=swap" rel="stylesheet" />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
		})} />
	</head>
	<body class="dp-body">
		<Header />
		<main class="bd">
			<section class="bd-hero">
				<span class="bd-eyebrow">DIABLO IV · 시즌 {data.season} · 보스 드랍</span>
				<h1>보스 드랍 테이블</h1>
				<p class="bd-lead">보스 {bosses.length}종이 주는 아이템 {totalDrops}개. 갖고 싶은 아이템 이름을 치면 잡아야 할 보스만 남겨 드려요.</p>
			</section>

			<div class="bd-tools" role="search">
				<input id="q" type="search" placeholder="아이템 이름으로 찾기 (예: 발덮개, 하를라)" aria-label="아이템 이름으로 찾기" />
				<div class="bd-chips" id="chips" role="group" aria-label="직업 거르기">
					<button type="button" class="on" data-c="" aria-pressed="true">전체</button>
					{CLASSES.slice(1).map(([id, ko]) => <button type="button" data-c={id} aria-pressed="false">{ko}</button>)}
				</div>
				<p class="bd-count" id="count" aria-live="polite"></p>
			</div>

			<nav class="bd-jump" aria-label="보스 바로가기">
				{bosses.map((b) => <a href={`#${b.id}`}>{nm(b)}</a>)}
				{mythics.length > 0 && <a href="#mythics" class="m">신화 고유</a>}
			</nav>

			{GROUPS.map(([g, gname, gdesc]) => {
				const list = bosses.filter((b) => b.group === g);
				return list.length > 0 && (
					<div class="bd-group" data-group={g}>
						<h2 class="bd-gh">{gname}<small>{gdesc}</small></h2>
						<div class="bd-list">
							{list.map((b) => (
								<section class="bd-boss" id={b.id} data-boss>
									<header class="bd-boss-head">
										<div>
											<h3>{nm(b)}{b.seasonal && <span class="bd-tag">시즌</span>}</h3>
											<p class="bd-sub">{b.en}{b.location_ko && ` · ${b.location_ko}`}</p>
										</div>
										{b.material && (b.material.ko || b.material.en) && (
											<div class="bd-mat">
												<span>🗝️ 비축고 열쇠</span>
												<b>{b.material.ko || b.material.en}{b.material.per_summon ? ` × ${b.material.per_summon}` : ''}</b>
											</div>
										)}
									</header>
									{b.material?.how_ko && <p class="bd-note"><b>열쇠 얻는 법</b> {b.material.how_ko}</p>}
									{b.trophy && <p class="bd-note"><b>우두머리 전리품</b> {b.trophy.ko || b.trophy.en} — 호라드림의 함에서 이 보스 고유로 바꿀 수 있어요.</p>}
									{b.tiers_ko && <p class="bd-note">{b.tiers_ko}</p>}
									{b.drops.length > 0 ? (
										<ul class="bd-drops">
											{b.drops.map((d) => (
												<li data-c={d.class} data-n={`${d.ko || ''} ${d.en}`.toLowerCase()} class={[d.mythic ? 'mythic' : '', d.unsure ? 'unsure' : ''].join(' ').trim()}>
													<span class="bd-item">{nm(d)}{d.unsure && <i class="bd-q" title={d.unsure}>확인 중</i>}<small>{d.ko ? d.en : ''}</small>{d.unsure && <small class="bd-why">{d.unsure}</small>}</span>
													<span class="bd-meta">{d.slot_ko}{d.slot_ko ? ' · ' : ''}<em class={`c-${d.class}`}>{CLS[d.class] || d.class}</em></span>
												</li>
											))}
										</ul>
									) : (
										<p class="bd-fixed">이 우두머리는 고정된 아이템 목록이 없어요. 위 설명대로 보상을 받습니다.</p>
									)}
									<p class="bd-empty" hidden>조건에 맞는 아이템이 없어요.</p>
								</section>
							))}
						</div>
					</div>
				);
			})}

			{mythics.length > 0 && (
				<section class="bd-boss bd-mythics" id="mythics">
					<header class="bd-boss-head"><div><h2>신화 고유</h2><p class="bd-sub">Mythic Uniques · 정해진 보스 없이 나오는 상징적 신화</p></div></header>
					{mythicNote && <p class="bd-note">{mythicNote}</p>}
					<div class="bd-table-wrap">
						<table>
							<thead><tr><th>아이템</th><th>부위</th><th>직업</th><th>얻는 곳</th></tr></thead>
							<tbody>
								{mythics.map((m) => (
									<tr data-c={m.class} data-n={`${m.ko || ''} ${m.en}`.toLowerCase()}>
										<td><b>{nm(m)}</b><small>{m.ko ? m.en : ''}</small></td><td>{m.slot_ko}</td><td>{m.equip?.length ? m.equip.map((c) => CLS[c]).join('·') : CLS[m.class] || m.class}</td><td>{m.from_ko}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</section>
			)}

			<section class="bd-doc">
				{rules.length > 0 && (<><h2>알아 둘 규칙</h2><ul>{rules.map((r) => <li>{r}</li>)}</ul></>)}
				<p>원하는 아이템을 찾았으면 <a href="/d4-build-planner/">디아블로4 빌드 플래너</a>에서 장비 칸에 넣고 빌드를 완성해 보세요.</p>
				<p>룬으로 만드는 아이템은 <a href="/d4-runewords/">디아블로4 룬워드 제작서</a>에 정리했어요.</p>
				<h2>자주 묻는 질문</h2>
				{faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
				<p class="bd-legal">게임월드7이 만든 팬 자료이며 Blizzard Entertainment와 관련이 없습니다. 아이템·보스 이름은 게임의 한국어 공식 표기를 따랐습니다. 시즌 {data.season} · {data.updated} 기준.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	.dp-body {
		--d-bg: #0d0b0a; --d-panel: #17130f; --d-panel-2: #1f1913; --d-line: #3a2f22;
		--d-gold: #c9a35b; --d-gold-hi: #e6c47f; --d-blood: #d9493a; --d-text: #ece3d3; --d-muted: #a89c88; --d-mythic: #c58cff;
		background: radial-gradient(1200px 500px at 50% -120px, #2a1a12 0%, transparent 70%), var(--d-bg);
		color: var(--d-text);
	}
	.bd { width: var(--maxw); max-width: calc(100% - 2rem); margin: 0 auto; padding: 1.5rem 0 3rem; }
	.bd h1, .bd h2 { font-family: 'Noto Serif KR', serif; }
	.bd-hero { text-align: center; padding: 1.5rem 0 1rem; }
	.bd-eyebrow { font-size: 0.75rem; letter-spacing: 0.18em; color: var(--d-gold); }
	.bd-hero h1 { font-size: clamp(2rem, 6vw, 3.2rem); font-weight: 900; margin: 0.4rem 0; color: #f4e6c8; text-shadow: 0 0 24px rgba(217, 73, 58, 0.35); }
	.bd-lead { color: var(--d-muted); max-width: 38em; margin: 0 auto; line-height: 1.7; }

	.bd-tools { position: sticky; top: 64px; z-index: 20; background: rgba(13, 11, 10, 0.92); backdrop-filter: blur(8px); padding: 12px 0 8px; margin-top: 10px; border-bottom: 1px solid var(--d-line); }
	.bd-tools input { width: 100%; background: var(--d-panel); border: 1px solid var(--d-line); color: var(--d-text); border-radius: 12px; padding: 12px 14px; font: inherit; font-size: 1rem; }
	.bd-tools input:focus { outline: none; border-color: var(--d-gold); }
	.bd-chips { display: flex; gap: 6px; margin-top: 8px; overflow-x: auto; padding-bottom: 2px; }
	.bd-chips button { flex: none; font: inherit; font-size: 0.84rem; padding: 7px 12px; border-radius: 999px; border: 1px solid var(--d-line); background: var(--d-panel); color: var(--d-muted); cursor: pointer; }
	.bd-chips button.on { background: var(--d-gold); color: #1a1208; border-color: var(--d-gold); font-weight: 800; }
	.bd-chips button:focus-visible, .bd-tools input:focus-visible, .bd-jump a:focus-visible { outline: 2px solid var(--d-gold-hi); outline-offset: 2px; }
	.bd-count { font-size: 0.8rem; color: var(--d-muted); margin: 6px 0 0; min-height: 1.2em; }

	.bd-jump { display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0 6px; }
	.bd-jump a { font-size: 0.82rem; padding: 5px 10px; border-radius: 8px; background: var(--d-panel); border: 1px solid var(--d-line); color: var(--d-text); text-decoration: none; }
	.bd-jump a:hover { border-color: var(--d-gold); }
	.bd-jump a.m { color: var(--d-mythic); border-color: #4b3566; }
	.bd-jump a.dim { opacity: 0.35; }

	.bd-group { margin-top: 26px; }
	.bd-gh { font-size: 1.25rem; color: #f4e6c8; margin: 0 0 4px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
	.bd-gh small { font-family: Pretendard, system-ui, sans-serif; font-size: 0.8rem; font-weight: 400; color: var(--d-muted); }
	.bd-group[hidden] { display: none; }
	.bd-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 14px; margin-top: 12px; }
	.bd-boss { background: var(--d-panel); border: 1px solid var(--d-line); border-radius: 16px; padding: 16px; scroll-margin-top: 170px; }
	.bd-boss[hidden] { display: none; }
	.bd-boss-head { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; border-bottom: 1px solid var(--d-line); padding-bottom: 10px; margin-bottom: 10px; }
	.bd-boss h2, .bd-boss h3 { font-family: 'Noto Serif KR', serif; margin: 0; font-size: 1.35rem; color: #f4e6c8; }
	.bd-tag { font-family: inherit; font-size: 0.68rem; vertical-align: middle; margin-left: 6px; padding: 2px 7px; border-radius: 999px; background: var(--d-blood); color: #fff; }
	.bd-sub { margin: 3px 0 0; font-size: 0.8rem; color: var(--d-muted); }
	.bd-mat { text-align: right; max-width: 48%; }
	.bd-mat span { display: block; font-size: 0.68rem; color: var(--d-muted); }
	.bd-mat b { display: block; font-size: 0.86rem; color: var(--d-gold-hi); }
	.bd-mat small { display: block; font-size: 0.72rem; color: var(--d-muted); line-height: 1.4; margin-top: 2px; }
	.bd-note { font-size: 0.8rem; color: var(--d-muted); margin: 0 0 8px; line-height: 1.55; }
	.bd-note b { color: var(--d-gold); font-weight: 700; margin-right: 4px; }
	.bd-fixed { font-size: 0.86rem; color: var(--d-text); background: var(--d-panel-2); border-radius: 8px; padding: 10px; margin: 0; }
	.bd-q { font-style: normal; font-size: 0.66rem; font-weight: 700; margin-left: 6px; padding: 1px 6px; border-radius: 999px; background: #4a3a1a; color: var(--d-gold-hi); vertical-align: middle; }
	.bd-why { color: #b89a6a !important; }
	.bd-drops li.unsure { border: 1px dashed #5a4526; }
	.bd-drops { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
	.bd-drops li { display: flex; justify-content: space-between; gap: 10px; padding: 7px 9px; border-radius: 8px; background: var(--d-panel-2); align-items: baseline; }
	.bd-drops li[hidden] { display: none; }
	.bd-item { color: #f0b56e; font-weight: 700; font-size: 0.93rem; min-width: 0; word-break: keep-all; }
	.bd-item small { display: block; font-weight: 400; font-size: 0.7rem; color: var(--d-muted); }
	.bd-drops li.mythic .bd-item { color: var(--d-mythic); }
	.bd-drops li.mythic { box-shadow: inset 2px 0 0 var(--d-mythic); }
	.bd-meta { flex: none; font-size: 0.74rem; color: var(--d-muted); text-align: right; }
	.bd-meta em { font-style: normal; color: var(--d-text); }
	.bd-meta em.c-all { color: var(--d-muted); }
	.bd-drops li.hit { outline: 1px solid var(--d-gold); }
	.bd-empty { font-size: 0.82rem; color: var(--d-muted); margin: 6px 0 0; }

	.bd-mythics { margin-top: 18px; border-color: #4b3566; }
	.bd-mythics h2 { color: var(--d-mythic); }
	.bd-table-wrap { overflow-x: auto; }
	.bd-mythics table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
	.bd-mythics th { text-align: left; color: var(--d-gold); font-size: 0.76rem; letter-spacing: 0.06em; padding: 6px 8px; border-bottom: 1px solid var(--d-line); }
	.bd-mythics td { padding: 8px; border-bottom: 1px solid var(--d-line); vertical-align: top; }
	.bd-mythics td b { color: var(--d-mythic); display: block; }
	.bd-mythics td small { color: var(--d-muted); font-size: 0.72rem; }
	.bd-mythics tr[hidden] { display: none; }

	.bd-doc { margin-top: 36px; border-top: 1px solid var(--d-line); padding-top: 20px; line-height: 1.75; }
	.bd-doc h2 { font-size: 1.3rem; color: #f4e6c8; margin: 0 0 6px; }
	.bd-doc a { color: var(--d-gold-hi); }
	.bd-doc details { border-bottom: 1px solid var(--d-line); padding: 8px 0; }
	.bd-doc summary { cursor: pointer; font-weight: 700; }
	.bd-doc p, .bd-doc li { color: var(--d-muted); }
	.bd-legal { font-size: 0.78rem; margin-top: 18px; }
	@media (max-width: 640px) { .bd-jump { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 4px; } .bd-jump a { flex: none; } }
	@media (max-width: 420px) { .bd-list { grid-template-columns: 1fr; } .bd-boss-head { flex-direction: column; } .bd-mat { text-align: left; max-width: none; } .bd-tools { top: 56px; } }
</style>

<script>
	const q = document.getElementById('q') as HTMLInputElement;
	const chips = document.getElementById('chips')!;
	let cls = '';
	function apply() {
		const t = q.value.trim().toLowerCase();
		let shown = 0, bossN = 0;
		document.querySelectorAll<HTMLElement>('[data-boss]').forEach((b) => {
			let n = 0;
			b.querySelectorAll<HTMLElement>('li[data-c]').forEach((li) => {
				const ok = (!cls || li.dataset.c === cls || li.dataset.c === 'all') && (!t || li.dataset.n!.includes(t));
				li.hidden = !ok; li.classList.toggle('hit', !!t && ok); if (ok) n++;
			});
			const fixed = !b.querySelector('li[data-c]'); // 고정 목록 없는 우두머리
			b.hidden = !!t && n === 0;
			(b.querySelector('.bd-empty') as HTMLElement).hidden = fixed || n > 0 || !!t;
			document.querySelector(`.bd-jump a[href="#${b.id}"]`)?.classList.toggle('dim', n === 0);
			shown += n; if (n) bossN++;
		});
		document.querySelectorAll<HTMLElement>('.bd-group').forEach((g) => { g.hidden = !!t && !g.querySelector('[data-boss]:not([hidden])'); });
		document.querySelectorAll<HTMLElement>('#mythics tr[data-c]').forEach((tr) => {
			tr.hidden = !((!cls || tr.dataset.c === cls || tr.dataset.c === 'all') && (!t || tr.dataset.n!.includes(t)));
		});
		document.getElementById('count')!.textContent = t || cls ? `보스 ${bossN}곳 · 아이템 ${shown}개` : '';
		const u = new URL(location.href);
		t ? u.searchParams.set('item', q.value.trim()) : u.searchParams.delete('item');
		cls ? u.searchParams.set('class', cls) : u.searchParams.delete('class');
		history.replaceState(null, '', u);
	}
	q.addEventListener('input', apply);
	chips.addEventListener('click', (e) => {
		const b = (e.target as HTMLElement).closest('button'); if (!b) return;
		cls = b.dataset.c || '';
		chips.querySelectorAll('button').forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
		apply();
	});
	const p = new URLSearchParams(location.search);
	if (p.get('item')) q.value = p.get('item')!;
	if (p.get('class')) (chips.querySelector(`[data-c="${p.get('class')}"]`) as HTMLButtonElement | null)?.click();
	else if (q.value) apply();
</script>
